#!/bin/bash
echo "=== Offline Engine Status ==="
echo -n "Ollama API: "; curl -sS -m 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && echo UP || echo DOWN
echo -n "Models: "; curl -sS -m 2 http://127.0.0.1:11434/api/tags 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin); print(", ".join(m["name"] for m in d.get("models",[])) or "(none)")' 2>/dev/null || echo "(error)"
echo -n "Loaded: "; curl -sS -m 2 http://127.0.0.1:11434/api/ps 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin); print(", ".join(m["name"] for m in d.get("models",[])) or "(none)")' 2>/dev/null || echo "(error)"
echo -n "grok-core: "; [ -x /root/.sovereign-grok/bin/grok-core ] && echo OK || echo MISSING
echo -n "grok-sovereign: "; [ -x /root/.sovereign-grok/bin/grok-sovereign ] && echo OK || echo MISSING
echo -n "grok symlink: "; readlink -f /usr/local/bin/grok 2>/dev/null || echo MISSING
echo -n "ladder lib: "; [ -f /root/mobile-tools/lib/framework_staging_ladder.sh ] && echo OK || echo MISSING
echo -n "su bind: "; [ -x /root/rnlu-cortex-programs/bin/su ] && echo OK || echo MISSING
echo -n "rish stub: "; [ -x /data/data/com.termux/files/home/bin/rish ] && echo OK || echo MISSING
echo -n "gmenu: "; [ -x /usr/local/bin/gmenu ] && echo OK || echo MISSING
echo -n "default model cfg: "; awk '/^\[models\]/{m=1;next}/^\[/{m=0} m&&/^default[[:space:]]*=/{print;exit}' /root/.sovereign-grok/config/config.toml 2>/dev/null || echo "?"
echo -n "su bind path: "; [ -x /root/rnlu-cortex-programs/bin/su ] && echo present || echo missing
echo -n "AI hive: "; ls /opt/ai-hive/*.py 2>/dev/null | wc -l | tr -d '\n'; echo " scripts"
echo -n "disk free: "; df -h / | awk 'NR==2{print $4}'
echo -n "mem avail: "; free -h | awk '/Mem:/{print $7}'
